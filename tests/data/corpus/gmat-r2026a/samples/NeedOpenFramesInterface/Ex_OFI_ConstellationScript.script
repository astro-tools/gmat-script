Create Spacecraft Sat44;

Sat44.DateFormat       = TAIModJulian;
Sat44.Epoch            = '21545';
Sat44.CoordinateSystem = EarthMJ2000Eq;
Sat44.DisplayStateType = Cartesian;
Sat44.X                = -6990.404995680331;
Sat44.Y                = -366.3516021126818;
Sat44.Z                = -1.697763572114679e-12;
Sat44.VX               = -0.05119577144137168;
Sat44.VY               = 1.04896595901142;
Sat44.VZ               = 7.472616549480826;

%----------------------------------------
%---------- Formation
%----------------------------------------

Create Formation form;
form.Add = {Sat11, Sat12, Sat13, Sat14, Sat21, Sat22, Sat23, Sat24, Sat31, Sat32, Sat33, Sat34, Sat41, Sat42, Sat43, Sat44};

%----------------------------------------
%---------- ForceModels
%----------------------------------------

Create ForceModel fm;

fm.CentralBody            = Earth;
fm.PointMasses            = {Earth, Sun, Luna};
fm.Drag                   = None;
fm.SRP                    = Off;
fm.RelativisticCorrection = Off;
fm.ErrorControl           = RSSStep;

%----------------------------------------
%---------- Propagators
%----------------------------------------

Create Propagator prop;

prop.FM                   = fm;
prop.Type                 = RungeKutta89;
prop.InitialStepSize      = 60;
prop.Accuracy             = 1.0e-11;
prop.MinStep              = 0.001;
prop.MaxStep              = 2700;
prop.MaxStepAttempts      = 50;
prop.StopIfAccuracyIsViolated = true;

%----------------------------------------
%---------- Subscribers
%----------------------------------------

Create OpenFramesInterface a3Dplot;

a3Dplot.SolverIterations        = Current;
a3Dplot.UpperLeft               = [ 0.15 0.07 ];
a3Dplot.Size                    = [ 0.7 0.86 ];
a3Dplot.Maximized               = false;
a3Dplot.Add                     = {Sat11, Earth, Sat21, Sat31, Sat41, Sat12, Sat22, Sat32, Sat42, Sat13, Sat23, Sat33, Sat43, Sat14, Sat24, Sat34, Sat44, Sun};
a3Dplot.DrawObject              = [ true true true true true true true true true true true true true true true true true ];
a3Dplot.View                    = {CoordinateSystemView1, EarthView1};
a3Dplot.CoordinateSystem        = EarthMJ2000Eq;
a3Dplot.DrawObject              = [ true true ];
a3Dplot.DrawTrajectory          = [ true true ];
a3Dplot.DrawAxes                = [ false false ];
a3Dplot.DrawXYPlane             = [ false false ];
a3Dplot.DrawLabel               = [ true true ];
a3Dplot.DrawUsePropLabel        = [ false false ];
a3Dplot.DrawCenterPoint         = [ true true ];
a3Dplot.DrawEndPoints           = [ true true ];
a3Dplot.DrawVelocity            = [ false false ];
a3Dplot.DrawGrid                = [ false false ];
a3Dplot.DrawLineWidth           = [ 2 2 ];
a3Dplot.DrawMarkerSize          = [ 10 10 ];
a3Dplot.Axes                    = On;
a3Dplot.AxesLabels              = On;
a3Dplot.FrameLabel              = Off;
a3Dplot.XYPlane                 = On;
a3Dplot.EclipticPlane           = Off;
a3Dplot.EnableStars             = On;
a3Dplot.StarCount               = 40000;
a3Dplot.MinStarMag              = -2;
a3Dplot.MaxStarMag              = 6;
a3Dplot.MinStarPixels           = 1;
a3Dplot.MaxStarPixels           = 10;
a3Dplot.MinStarDimRatio         = 0.5;
a3Dplot.ShowPlot                = true;
a3Dplot.ShowToolbar             = true;
a3Dplot.SolverIterLastN         = 0;
a3Dplot.ShowVR                  = false;
a3Dplot.PlaybackTimeScale       = 3600;
a3Dplot.MultisampleAntiAliasing = On;
a3Dplot.MSAASamples             = 2;

%----------------------------------------
%---------- View Objects
%----------------------------------------

Create OpenFramesView CoordinateSystemView1;

CoordinateSystemView1.ViewFrame          = CoordinateSystem;
CoordinateSystemView1.ViewTrajectory     = Off;
CoordinateSystemView1.InertialFrame      = Off;
CoordinateSystemView1.SetDefaultLocation = Off;
CoordinateSystemView1.SetCurrentLocation = On;
CoordinateSystemView1.CurrentEye         = [ 1000 -18000 10000 ];
CoordinateSystemView1.CurrentCenter      = [ 0 0 0 ];
CoordinateSystemView1.CurrentUp          = [ 0 0 1 ];

Create OpenFramesView EarthView1;

EarthView1.ViewFrame                     = Earth;
EarthView1.ViewTrajectory                = Off;
EarthView1.InertialFrame                 = Off;
EarthView1.SetDefaultLocation            = Off;
EarthView1.SetCurrentLocation            = On;
EarthView1.CurrentEye                    = [ 4000 -20000 3000 ];
EarthView1.CurrentCenter                 = [ 0 0 0 ];
EarthView1.CurrentUp                     = [ 0 0 1 ];

%----------------------------------------
%---------- Mission Sequence
%----------------------------------------
BeginMissionSequence;

Propagate 'Prop 1 Day' prop(form) {Sat11.ElapsedSecs = 86400.0};




