LRO.NAIFIdReferenceFrame         = -9008001;
LRO.OrbitColor                   = Red;
LRO.TargetColor                  = Teal;
LRO.OrbitErrorCovariance         = [ 1e+070 0 0 0 0 0 ; 0 1e+070 0 0 0 0 ; 0 0 1e+070 0 0 0 ; 0 0 0 1e+070 0 0 ; 0 0 0 0 1e+070 0 ; 0 0 0 0 0 1e+070 ];
LRO.CdSigma                      = 1e+070;
LRO.CrSigma                      = 1e+070;
