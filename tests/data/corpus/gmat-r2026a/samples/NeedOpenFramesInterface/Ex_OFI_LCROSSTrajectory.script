EarthMoonView.CurrentCenter      = [ 1.164153218269348e-10 0 0 ];
EarthMoonView.CurrentUp          = [ -0.408248290463863 -0.4082482904638629 0.8164965809277262 ];
EarthMoonView.FOVy               = 45;

