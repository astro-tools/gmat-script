MoonInertialView.DefaultCenter      = [ 0 0 0 ];
MoonInertialView.DefaultUp          = [ 0 0 1 ];
MoonInertialView.SetCurrentLocation = On;
MoonInertialView.CurrentEye         = [ 12000 12000 12000 ];
MoonInertialView.CurrentCenter      = [ 1.818989403545856e-12 0 0 ];
MoonInertialView.CurrentUp          = [ -0.408248290463863 -0.4082482904638629 0.8164965809277262 ];
MoonInertialView.FOVy               = 45;

